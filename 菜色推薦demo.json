    {
      "parameters": {
        "jsCode": "// $input.all() 是菜單表格資料 (每列一個 item)\nconst menuItems = $input.all().map(item => item.json);\n\n// 1. 先拿到 static data 物件（global 範圍）\nconst staticData = $getWorkflowStaticData('global');\n\n// 2. 把菜單存進去，讓其它 workflow 節點都可以用\nstaticData.menu = menuItems;\n\n// 3. 把資料往後傳（如果後面還有節點要用）\nreturn [\n  {\n    json: {\n      staticData\n    },\n  },\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        -64
      ],
      "id": "1abc31d2-e36d-4304-b06e-d423b3ed7747",
      "name": "儲存菜單至全域變數中"
    },
    {
      "parameters": {
        "jsCode": "// 1. 從 static data 拿菜單\nconst staticData = $getWorkflowStaticData('global');\nconst menu = staticData.menu || [];\n\n// 2. 取得剛剛 AI 回傳的 JSON(限制條件)\nconst rawText = $json.content?.parts?.[0]?.text || '{}';\nlet config;\ntry {\n  config = JSON.parse(rawText);\n} catch (error) {\n  config = {};\n}\n\nconst filters = config.filters || [];\nconst sortBy = config.sortBy || null;\nconst sortOrder = (config.sortOrder || 'ASC').toUpperCase();\nconst limit = config.limit ?? 10;\n\nfunction matchFilter(row, f) {\n  const fieldValue = row[f.field];\n\n  if (fieldValue === undefined || fieldValue === null) return true;\n\n  const isArray = Array.isArray(fieldValue);\n  const valueStr = isArray ? fieldValue.join(',') : String(fieldValue);\n\n  switch (f.operator) {\n    case 'EXCLUDES':\n      return !(f.values || []).some((v) => valueStr.includes(String(v)));\n\n    case 'INCLUDES':\n      return (f.values || []).some((v) => valueStr.includes(String(v)));\n\n    case '==':\n      return String(fieldValue) == String(f.value);\n\n    case '!=':\n      return String(fieldValue) != String(f.value);\n\n    case '<':\n      return Number(fieldValue) < Number(f.value);\n\n    case '<=':\n      return Number(fieldValue) <= Number(f.value);\n\n    case '>':\n      return Number(fieldValue) > Number(f.value);\n\n    case '>=':\n      return Number(fieldValue) >= Number(f.value);\n\n    default:\n      return true;\n  }\n}\n\n// 3. 套用所有篩選條件\nlet results = menu.filter((row) =>\n  filters.every((f) => matchFilter(row, f)),\n);\n\n// 4. 排序\nif (sortBy) {\n  results = results.sort((a, b) => {\n    const av = a[sortBy];\n    const bv = b[sortBy];\n    if (av == null && bv == null) return 0;\n    if (av == null) return 1;\n    if (bv == null) return -1;\n    const numA = Number(av);\n    const numB = Number(bv);\n    if (!Number.isNaN(numA) && !Number.isNaN(numB)) {\n      return sortOrder === 'DESC' ? numB - numA : numA - numB;\n    }\n    // 字串排序\n    const sa = String(av);\n    const sb = String(bv);\n    return sortOrder === 'DESC' ? sb.localeCompare(sa) : sa.localeCompare(sb);\n  });\n}\n\n// 5. 限制筆數\nif (limit != null) {\n  results = results.slice(0, limit);\n}\n\n// 6. 傳給下一個節點\nreturn [\n  {\n    json: {\n      all_menu: menu,\n      constraints: config,\n      candidates: results,\n    },\n  },\n];\n"
      },
